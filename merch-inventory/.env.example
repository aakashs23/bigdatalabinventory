# Copy this file to .env and put your own values in it:
#   cp .env.example .env
# .env is ignored by git, so your real password is never committed.

# MongoDB (no password: it only listens on localhost for this lab)
MONGO_URI=mongodb://localhost:27017

# Neo4j (password must be at least 8 characters)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please
